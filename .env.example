# Copy to .env and fill in ONE provider. Without any key the app still runs in
# retrieval-only mode (it shows the evidence, without a generated answer).

# gemini (default, free tier at https://aistudio.google.com/apikey) | groq | ollama
LLM_PROVIDER=gemini

# Optional: overrides the provider's default model
# LLM_MODEL=gemini-flash-lite-latest

GOOGLE_API_KEY=
GROQ_API_KEY=

# Only for LLM_PROVIDER=ollama (local, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
